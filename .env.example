# Copia este archivo con el nombre ".env" y pega tu clave gratuita de Finnhub
# (https://finnhub.io -> "Get free API key"). Sin clave, la capa de bolsa queda sin activar.
FINNHUB_API_KEY=

# Clave gratuita de Twelve Data (https://twelvedata.com), para los gráficos de precio de las empresas.
TWELVEDATA_API_KEY=

# Tu correo de contacto. La SEC (registro oficial de EE. UU.) lo exige para dejar descargar
# los ingresos y beneficios de las empresas. No se publica en ningún sitio.
SEC_CONTACTO=
